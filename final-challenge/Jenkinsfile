pipeline {
    agent any

    tools {
        jdk 'jdk'
        nodejs 'Node'
    }

    environment {
        SCANNER_HOME          = tool 'sonar'
        DOCKER_REGISTRY       = 'theenigmawolf'
        DOCKER_CREDENTIALS_ID = 'docker'
        BACKEND_IMAGE         = 'user-service'
        FRONTEND_IMAGE        = 'frontend-service'
        MANIFEST_FILE         = 'final-challenge/k8s/03-deployments.yaml'
        GIT_REPO_NAME         = 'sample'
        GIT_USER_NAME         = 'ejazshaikh-devops'
        GIT_EMAIL             = 'ejazs720@gmail.com'
        GIT_CREDENTIALS_ID    = 'github'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: "https://github.com/ejazshaikh-devops/sample.git"
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh """
                        ${SCANNER_HOME}/bin/sonar-scanner \
                        -Dsonar.projectName=AbhiEjazShop \
                        -Dsonar.projectKey=AbhiEjazShop
                    """
                }
            }
        }

        stage('Quality Gate') {
            steps {
                waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token'
            }
        }

        // Copy the modified nginx.conf into the frontend build context before
        // building — same requirement as RUNBOOK.md Step 2.
        stage('Prep Frontend Config') {
            steps {
                sh 'cp final-challenge/frontend-nginx/nginx.conf final-challenge/services/frontend/nginx.conf'
            }
        }

        stage('Build & Push Backend Image') {
            steps {
                script {
                    def imageTag         = "${BACKEND_IMAGE}:${BUILD_NUMBER}"
                    def registryImageTag = "${DOCKER_REGISTRY}/${imageTag}"
                    sh "docker build -f final-challenge/services/user-service/Dockerfile -t ${imageTag} final-challenge"
                    withDockerRegistry(credentialsId: DOCKER_CREDENTIALS_ID, toolName: 'docker') {
                        sh """
                            docker tag ${imageTag} ${registryImageTag}
                            docker push ${registryImageTag}
                        """
                    }
                }
            }
        }

        stage('Build & Push Frontend Image') {
            steps {
                script {
                    def imageTag         = "${FRONTEND_IMAGE}:${BUILD_NUMBER}"
                    def registryImageTag = "${DOCKER_REGISTRY}/${imageTag}"
                    sh "docker build -f final-challenge/services/frontend/Dockerfile -t ${imageTag} final-challenge/services/frontend"
                    withDockerRegistry(credentialsId: DOCKER_CREDENTIALS_ID, toolName: 'docker') {
                        sh """
                            docker tag ${imageTag} ${registryImageTag}
                            docker push ${registryImageTag}
                        """
                    }
                }
            }
        }

        stage('Update Manifest and Push to GitHub') {
            steps {
                script {
                    def newBackendImage  = "${DOCKER_REGISTRY}/${BACKEND_IMAGE}:${BUILD_NUMBER}"
                    def newFrontendImage = "${DOCKER_REGISTRY}/${FRONTEND_IMAGE}:${BUILD_NUMBER}"
                    withCredentials([usernamePassword(credentialsId: GIT_CREDENTIALS_ID, usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
                        sh """
                            git config user.email "${GIT_EMAIL}"
                            git config user.name "${GIT_USER_NAME}"

                            # Targeted replace: match on the image name itself, not a
                            # blanket 'image: .*' that would clobber both containers.
                            sed -i "s|image: .*/user-service:.*|image: ${newBackendImage}|" ${MANIFEST_FILE}
                            sed -i "s|image: .*/frontend-service:.*|image: ${newFrontendImage}|" ${MANIFEST_FILE}

                            git add ${MANIFEST_FILE}
                            git commit -m "Update images to build ${BUILD_NUMBER}" || echo "No changes"
                            git push https://${GIT_USER}:${GIT_PASS}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
                        """
                    }
                }
            }
        }
    }
}
